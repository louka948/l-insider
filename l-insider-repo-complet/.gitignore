# Environnement du sandbox (pas du projet) — jamais à versionner.
.cache/
.claude/
.config/
.gitconfig
.npm/
.npm-global/
.ssh/
.wget-hsts

# Copie locale de doc du projet Claude (claude/etat-imposteur-foot.md) —
# synchronisée via l'outil Projects, ne fait pas partie du code du jeu,
# jamais à versionner ici.
claude/

# Dépendances régénérables (npm install les recrée).
build/node_modules/
node_modules/

# Fichiers générés par build/assemble.js (noyau + screens/*.jsx réunis) —
# régénérés à chaque npm test / npm run dev, jamais à versionner.
.assembled-for-tests.html
dev-preview.html

# Copie de index.html utilisée par Capacitor comme "webDir" (voir
# capacitor.config.ts) — régénérée par `npm run cap:sync`, jamais à éditer
# directement (même logique que index.html à la racine : c'est un artefact
# de build, pas une source).
www/

# Captures d'écran produites par scripts/screenshot-*.js (auto-critique
# visuelle pendant une session de design) — jamais à versionner.
shots/

# Skills Claude Code installés localement via `npx skills add ...` (outillage
# personnel de session, sans rapport avec le jeu) — jamais à versionner ici.
.agents/
skills-lock.json
dist/

# landing/linsider-landing.html (la landing page) est maintenant versionné
# : décision prise le 27 août 2026 de la déployer pour de vrai via GitHub
# Pages (voir .github/workflows/deploy-pages.yml à la racine du dépôt) —
# elle n'est donc plus un simple brouillon. Seuls les autres fichiers de ce
# dossier (captures, scripts one-off) restent ignorés.
landing/*
!landing/linsider-landing.html

# Paquet de déploiement combiné (landing/ à la racine + jeu buildé dans
# jouer/) assemblé en session le 27 août 2026 pour que l'utilisateur puisse
# glisser-déposer un seul dossier sur Netlify et garder landing + jeu sur le
# même site. Recréable à volonté depuis landing/ + npm run build — jamais à
# versionner tel quel.
deploy-site/
deploy-site.zip
